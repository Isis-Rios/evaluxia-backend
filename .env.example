# ──────────────────────────────────────────────────────────────────────────────
# EvalUXIA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local (Docker):
MONGODB_URI=mongodb://mongo:27017/evaluxia
# Atlas (Production):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/evaluxia?retryWrites=true&w=majority

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── CORS ────────────────────────────────────────────────────────────────────
# In development: * (allow all)
# In production: https://your-frontend-domain.com
CORS_ORIGIN=*
