# ──────────────────────────────────────────────────────────────────────────────
# EvalUXIA Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local (Docker):
MONGODB_URI=mongodb://mongo:27017/evaluxia
# Atlas (Production):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/evaluxia?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_random_64_byte_hex_string_for_access_token
JWT_REFRESH_SECRET=change_me_to_a_different_random_64_byte_hex_string_for_refresh_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Optional for this iteration — required for AI evaluation features
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ─── CORS ────────────────────────────────────────────────────────────────────
# In development: * (allow all)
# In production: https://your-frontend-domain.com
CORS_ORIGIN=*
